<?xml version="1.0" encoding="UTF-8"?>
<!--
    CampusRide - College Bus Pass & Route Allocation System
    Maven build file. Open this folder in Eclipse (File > Import > Existing Maven Project)
    or IntelliJ (File > Open > select this folder) and the IDE reads everything from here.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.campusride</groupId>
    <artifactId>campusride</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>CampusRide</name>

    <properties>
        <!-- Compile for Java 17 even if a newer JDK is installed -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Class started by "mvn exec:java" (can be overridden with -Dexec.mainClass=...) -->
        <exec.mainClass>com.campusride.Main</exec.mainClass>
    </properties>

    <dependencies>
        <!-- The ONLY library we use: the official MySQL JDBC driver.
             Maven downloads it automatically; we never commit the JAR. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lets us start the app with:  mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
            </plugin>
        </plugins>
    </build>
</project>
